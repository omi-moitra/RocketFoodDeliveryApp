    {
      "name": "POST /api/orders — successful create (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('order is created with the Success envelope', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant_id\": {{restaurantId}},\n  \"customer_id\": {{customerId}},\n  \"products\": [\n    {\n      \"id\": {{productId}},\n      \"quantity\": 2\n    }\n  ],\n  \"sendEmail\": false,\n  \"sendSMS\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        },
        "description": "Creates one order with NEITHER notification (sendSMS/sendEmail both false). These official camelCase notification keys are the backend's canonical HTTP contract. Expects HTTP 201 with { message: 'Success', data: <created order DTO> }."
      }
    },
