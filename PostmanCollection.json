{
  "info": {
    "name": "Rocket Food Delivery — Module 13",
    "description": "Preconfigured requests for every endpoint used by the Module 13 mobile client. Run 'POST /api/auth — valid credentials' first: its test script stores the bearer token and customer ID as collection variables so protected requests need no manual edits. The collection covers restaurant listing and filters, restaurant details, restaurant products, order creation, customer order history, and relevant failure cases. The default baseUrl targets the local backend on port 8080; replace it with the active ngrok HTTPS URL when testing through a tunnel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/auth — valid credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('login succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.success).to.eql(true);",
              "});",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('customerId', String(body.customer_id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth"]
        },
        "description": "Authenticates the seeded customer and captures accessToken plus customer_id for the protected order requests."
      }
    },
    {
      "name": "GET /api/restaurants — all restaurants (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('restaurant list loads with the Success envelope', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants"]
        },
        "description": "Loads the complete restaurant list used by the Restaurants tab before filters are selected."
      }
    },
    {
      "name": "GET /api/restaurants — combined rating and price filters (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('combined restaurant filters return an array', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants?rating={{rating}}&price_range={{priceRange}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants"],
          "query": [
            { "key": "rating", "value": "{{rating}}" },
            { "key": "price_range", "value": "{{priceRange}}" }
          ]
        },
        "description": "Exercises the exact combined integer filters used by the restaurant-list screen. An empty data array is a valid no-matches result."
      }
    },
    {
      "name": "GET /api/restaurants/{id} — restaurant detail (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('selected restaurant detail loads', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(Number(body.data.id)).to.eql(Number(pm.collectionVariables.get('restaurantId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants", "{{restaurantId}}"]
        },
        "description": "Loads the selected restaurant summary used at the top of the dynamic Restaurant Menu route."
      }
    },
    {
      "name": "GET /api/restaurants/{id} — unknown restaurant (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unknown restaurant is not found', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants/{{unknownRestaurantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants", "{{unknownRestaurantId}}"]
        },
        "description": "Proves that a restaurant ID not present in the database returns HTTP 404 instead of a malformed success object."
      }
    },
    {
      "name": "GET /api/products — restaurant menu products (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('restaurant products load with the Success envelope', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?restaurant={{restaurantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "restaurant", "value": "{{restaurantId}}" }
          ]
        },
        "description": "Loads only the products belonging to the selected restaurant for the Restaurant Menu screen."
      }
    },
    {
      "name": "GET /api/restaurants — missing bearer token (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('protected restaurant list rejects a missing token', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants"]
        },
        "description": "Exercises the current Spring Security behavior observed for a protected API request without a Bearer token."
      }
    },
    {
      "name": "POST /api/orders — successful create (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('order is created with the Success envelope', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant_id\": {{restaurantId}},\n  \"customer_id\": {{customerId}},\n  \"products\": [\n    {\n      \"id\": {{productId}},\n      \"quantity\": 2\n    }\n  ],\n  \"send_email\": false,\n  \"send_sms\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        },
        "description": "Creates one order for the authenticated customer using seeded restaurant 1 and its seeded product 1. Expects HTTP 201 with { message: 'Success', data: <created order DTO> }."
      }
    },
    {
      "name": "POST /api/orders — invalid product ID (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('invalid product is rejected as Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(body.error).to.eql('Bad Request');",
              "    pm.expect(body.details).to.eql('Invalid or missing parameters');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant_id\": {{restaurantId}},\n  \"customer_id\": {{customerId}},\n  \"products\": [\n    {\n      \"id\": 999999,\n      \"quantity\": 2\n    }\n  ],\n  \"send_email\": false,\n  \"send_sms\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        },
        "description": "Uses a product ID that does not exist so the backend rejects the body with HTTP 400 { error: 'Bad Request', details: 'Invalid or missing parameters' }."
      }
    },
    {
      "name": "GET /api/orders — customer order history (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('order history loads for the authenticated customer', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders?type=customer&id={{customerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"],
          "query": [
            { "key": "type", "value": "customer" },
            { "key": "id", "value": "{{customerId}}" }
          ]
        },
        "description": "Lists every order belonging to the authenticated customer captured by the auth request. Expects HTTP 200 with { message: 'Success', data: [ ...order objects... ] }; an empty array is a valid no-orders result."
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "customerId", "value": "2" },
    { "key": "restaurantId", "value": "1" },
    { "key": "unknownRestaurantId", "value": "999999" },
    { "key": "rating", "value": "4" },
    { "key": "priceRange", "value": "2" },
    { "key": "productId", "value": "1" }
  ]
}
