              "    pm.expect(body.courier_id).to.be.ok;",
              "    pm.expect(body.customer_id == null).to.eql(true);",
              "});",
              "pm.collectionVariables.set('courierAccessToken', body.accessToken);",
              "pm.collectionVariables.set('courierUserId', String(body.user_id));",
              "pm.collectionVariables.set('courierId', String(body.courier_id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"courier@example.com\",\n  \"password\": \"{{demoPassword}}\"\n}"
