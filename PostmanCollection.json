{
  "info": {
    "name": "Rocket Food Delivery — Modules 13 and 14",
    "description": "Preconfigured requests for the retained Module 13 customer flow and the Module 14 role-aware, courier, Account, and notification extensions. Run the customer-only and courier-only authentication requests first: their tests capture separate role-scoped tokens and IDs for the protected requests that follow; the dual-role request independently verifies both role IDs. The collection covers restaurant browsing, order creation with all notification combinations, customer history, courier retrieval/status/assignment, role-specific Account reads and updates, and relevant failure cases. The default baseUrl targets the local backend on port 8080; replace it with the active ngrok HTTPS URL when testing through a tunnel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/auth — customer-only login (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('customer-only login returns only the customer role', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.customer_id).to.be.ok;",
              "    pm.expect(body.courier_id == null).to.eql(true);",
              "});",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('userId', String(body.user_id));",
              "pm.collectionVariables.set('customerId', String(body.customer_id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"{{demoPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth"]
        },
        "description": "Authenticates the seeded customer-only account and captures its token, user ID, and customer ID for protected customer requests."
      }
    },
    {
      "name": "POST /api/auth — courier-only login (200)",
      "event": [
        {
          "listen": "test",
          "script": {
