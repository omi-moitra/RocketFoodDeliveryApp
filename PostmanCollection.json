    {
      "name": "PUT /api/orders/{id} — pending to in progress (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('status advances to in progress', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.message).to.eql('Success');",
              "    pm.expect(body.data.status).to.eql('in progress');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{courierAccessToken}}" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant_id\": {{restaurantId}},\n  \"customer_id\": {{customerId}},\n  \"order_status_id\": 2,\n  \"restaurant_rating\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}"]
        },
        "description": "Broad order update advancing the status to in progress. The client echoes the order's own restaurant_id, customer_id, and current restaurant_rating (from the order response, which now exposes it) so only the status changes and the rating is not erased. Courier is not part of this body, so an existing assignment is preserved. Use a disposable order ID. Step 1 of accepting a pending delivery; the client follows it with the courier assignment below."
      }
    },
    {
      "name": "PUT /api/order/{id}/courier — assign the active courier (200)",
      "event": [
