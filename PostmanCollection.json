      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{courierAccessToken}}" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
